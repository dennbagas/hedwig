{{- if eq .Action "opened" -}}
📢 New Pull Request!

{{quote (printf "Repository: %s\nTitle: %s\nAuthor: %s\n\nPull Request URL:\n%s" .Repo .Title .Author .URL)}}
{{- else if and (eq .Action "closed") .Merged -}}
✅ Pull Request Merged!

{{quote (printf "Repository: %s\nTitle: %s\nAuthor: %s\nMerged by: %s\n\nPull Request URL:\n%s" .Repo .Title .Author .MergedBy .URL)}}
{{- else if and (eq .Action "closed") (not .Merged) -}}
🚫 Pull Request Closed!

{{quote (printf "Repository: %s\nTitle: %s\nAuthor: %s\n\nPull Request URL:\n%s" .Repo .Title .Author .URL)}}
{{- end -}}
